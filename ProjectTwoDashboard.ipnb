@app.callback(Output('datatable-id','data'),
              [Input('filter-type', 'value')]
             )

## FIX ME Add code to filter interactive data table with MongoDB queries
#        columns=[{"name": i, "id": i, "deletable": False, "selectable": True} for i in df.columns]
#        data=df.to_dict('records')
#        return (data,columns)

def update_dashboard(filter_type):
    #Map radio buttons for rescue
    if filter_type == "water":
        #contents of query
        query = {
            #will set the animal type to dog
            "animal_type": "Dog",
            #set the breeds in this category
            "breed": {"$in": [
                "Labrador Retriever Mix",
                "Chesapeake Bay Retriever",              
                "Newfoundland"
            ]},
                      #prefered sex outcome
            "sex_upon_outcome": {"$regex": "Intact Female", "$options": "i"},
            #age set on weeks
            "age_upon_outcome_in_weeks": {"$gte": 26, "$lte": 156}
        }
        
        
    elif filter_type == "mountain":
        query = {
            "animal_type": "Dog",
            "breed":{"$in": [
                "German Shepherd",
                "Alaskan Malamute",
                "Old English Sheepdog",
                "Siberian Husky",
                "Rottweiler"
            ]},
            
            "sex_upon_outcome": {"$regex": "Intact Male", "$options": "i"},
            "age_upon_outcome_in_weeks": {"$gte": 26, "$lte": 156}
        }
        
    elif filter_type == "disaster":
        query = {
            "animal_type": "Dog",
            "breed":{"$in": [
                "Doberman Pinscher",
                "German Shepherd",
                "Golden Retriever",
                "Bloodhound",
                "Rottweiler"
            ]},
            "sex_upon_outcome": {"$regex": "Intact Male", "$options": "i"},
            "age_upon_outcome_in_weeks": {"$gte": 20, "$lte": 300}
        }
        
    #reset query
    else: 
        query = {}
        

    #age in weeks filter
    #will divide the ages in different ranges
                
    #Query MongoDB
    data = db.read_all(query)
    
    #convert to dataframe
    dff = pd.DataFrame.from_records(data)
   
    #fix to handle empty results
    if dff.empty:
        return[]
    
    #MongoDB_id
    if "_id" in dff.columns:
        dff.drop(columns=['_id'], inplace=True)
    #return records as dict
    return dff.to_dict('records')

# Display the breeds of animal based on quantity represented in
# the data table Graph callback
@app.callback(
    Output('graph-id', "children"),
    [Input('datatable-id', "derived_virtual_data"),
     Input('filter-type', 'value')
    ]
)

def update_graphs(viewData, filter_type):
    ###FIX ME ####
    # add code for chart of your choice (e.g. pie chart) #
    
    if not viewData:
        
        return html.Div()
    
    #dataframe for pie chart
    dff = pd.DataFrame.from_dict(viewData)
    
    if "breed" not in dff.columns:
        return html.Div()
    
    #sets fig as figure for the return\
    #if filter not "reset" then the chart will only show the dogs otherwise all animals will display
    if filter_type != "reset":
        if "animal_type" in dff.columns:
            dff = dff[dff["animal_type"].str.contains("Dog", case=False, na=False)]
    if dff.empty:
        return html.Div()
    
    fig = px.pie(dff, names='breed', title='Breed Distribution')
    
    return [dcc.Graph(figure=fig)]
    


    #return [
    #    dcc.Graph(            
    #        figure = px.pie(df, names='breed', title='Preferred Animals')
    #    )    
    #]
    
#This callback will highlight a cell on the data table when the user selects it
@app.callback(
    Output('datatable-id', 'style_data_conditional'),
    [Input('datatable-id', 'selected_columns')
    ]
)
def update_styles(selected_columns):
    if not selected_columns:
        return[]
    #used col rather than i
    return [{
        'if': { 'column_id': col},
        'background_color': '#D2F3FF'
    } for col in selected_columns]


# This callback will update the geo-location chart for the selected data entry
# derived_virtual_data will be the set of data available from the datatable in the form of 
# a dictionary.
# derived_virtual_selected_rows will be the selected row(s) in the table in the form of
# a list. For this application, we are only permitting single row selection so there is only
# one value in the list.
# The iloc method allows for a row, column notation to pull data from the datatable

#fix getting indexing issues
@app.callback(
    Output('map-id', "children"),
    [Input('datatable-id', "derived_virtual_data"),
     Input('datatable-id', "derived_virtual_selected_rows")
    ]
)
def update_map(viewData, index):  
    #data means map defaults to Austin, Texas
    default_lat = 30.75
    default_lon = -97.48
    #if no data loop
    if not viewData:
        
        return [
            dl.Map(
                style={'width': '1000px', 'height': '300px'},
                center=[default_lat, default_lon], zoom=10,
                children=[dl.TileLayer(id="base-layer-id")]
            )
        ]
    
    dff = pd.DataFrame.from_dict(viewData)
    
    #require columns cordinates
    required = ["location_lat", "location_long", "breed", "name"]
    for col in required:
        if col not in dff.columns:
            return [
                dl.Map(
                    style={'width': '1000px', 'height': '300px'},
                    center=[default_lat, default_lon], zoom=10,
                    children=[dl.TileLayer(id="base-layer-id")]
                )
            ]
        
     #row selection   
    if not index:
        row = 0
    else: 
        row = index[0]
    
    #prevents out of range errors
    if row >= len(dff):
        row = 0
    #marker position values    
    lat = dff.iloc[row]["location_lat"]
    lon = dff.iloc[row]["location_long"]
    breed = dff.iloc[row]["breed"]
    name = dff.iloc[row]["name"]
    
        
    # Austin TX is at [30.75,-97.48]
    
            # Marker with tool tip and popup
            # Column 13 and 14 define the grid-coordinates for the map
            # Column 4 defines the breed for the animal
            # Column 9 defines the name of the animal
            #the fixed posistions are giving me indexing issues    
    return [
        dl.Map(style={'width': '1000px', 'height': '500px'}, center=[lat,lon], zoom=10, children=[
            dl.TileLayer(id="base-layer-id"),
            dl.Marker(
                position=[lat, lon], 
                children=[
                    dl.Tooltip(breed),
                    dl.Popup([
                        html.H1("Animal Name"),
                        html.P(name)
                    ])
                ])
        ])
    ]


